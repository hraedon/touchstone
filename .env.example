# Copy to .env (gitignored) and fill in. Nothing here belongs in git.

# Postgres. The deployment runs migrations before the app, so this role must own
# the database.
TOUCHSTONE_DSN=postgresql+psycopg://touchstone:CHANGEME@db.example.internal:5432/touchstone

# eBay application keyset (Developer Portal -> Application Keys, production).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Marketplace Account Deletion endpoint.
#   VERIFICATION_TOKEN: 32-80 chars, [A-Za-z0-9_-] only. `openssl rand -hex 32`.
#   ENDPOINT_URL: must match the developer-portal value BYTE FOR BYTE, including
#   the trailing slash — the string is hashed into the challenge response, and a
#   mismatch fails validation with no useful error.
VERIFICATION_TOKEN=
ENDPOINT_URL=https://ebdel.hraedon.com/

# Web UI. Signs the session cookie that carries flash messages; 32+ characters.
#   `openssl rand -hex 32`. Deliberately required rather than generated per process:
#   a generated key works perfectly in a one-replica test and silently invalidates
#   every session on each restart and rollout in production.
TOUCHSTONE_SECRET_KEY=
# Set to 1 only for local HTTP development; it drops the Secure flag on the cookie.
# TOUCHSTONE_INSECURE_COOKIES=1

# Seller exclusions (optional). A hand-authored list of eBay usernames whose
# listings are never retrieved — applied server-side in the Browse filter, never
# stored in the database, never written to the logs. Comma- or newline-separated;
# '#' starts a comment. See docs/deletion-compliance.md for why holding this is
# defensible and what keeps it so. NOTHING may add to this list automatically.
TOUCHSTONE_EXCLUDED_SELLERS=
# Required whenever the list above is set. Keys the per-scan digest so the database
# records that the list changed without recording who is on it. `openssl rand -hex 16`.
TOUCHSTONE_EXCLUSION_SALT=

# Retention. `touchstone prune` is a dry run unless --apply is given, and refuses a
# horizon under 30 days. In the cluster this runs as a suspended CronJob.

# Title extraction. Any model id ending in -lab is rejected at startup.
UMANS_API_KEY=
TOUCHSTONE_EXTRACT_MODEL=umans-flash
