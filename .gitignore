# Environments and build artifacts
.venv/
__pycache__/
*.pyc
*.egg-info/
dist/
build/

# Caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/

# Runtime data — never commit observed listing data. Raw Browse responses contain
# seller identifiers that the client deliberately discards before persistence.
# Putting a capture in git history would defeat that data-minimization boundary.
samples/
data/
*.db
*.sqlite3

# Secrets
.env
*.local
.identifiers-denylist.local
deploy/k8s/secret-*.yaml

# Vim swap files can contain complete copies of secret-bearing buffers. The final
# pattern covers Vim's collision sequence from .swp through .saa.
*.swp
*.swo
.*.s[a-w][a-z]

# Agent tooling (agent-notes writes SessionStart/Stop hooks here per checkout)
.claude/

# OS
.DS_Store
